#!/usr/bin/env python3
"""A stand-in for `claude setup-token`: prints an OSC-8 link, asks for the code, prints a token.

Never contacts anything. The code `good-code` succeeds; anything else is refused. It reports
nothing: it exits without a link when it was given a credential or a HOME not made for it.
"""
import os
import sys

if sys.argv[1:] != ["setup-token"]:
    sys.exit(2)
url = "https://claude.ai/oauth/authorize?code=true&client_id=fake&state=abc123&code_challenge=xyz"
# Refuses to start (no link) if it was handed a credential or the machine's own HOME / config.
if any(name in os.environ for name in ("ANTHROPIC_API_KEY", "CLAUDE_CODE_OAUTH_TOKEN", "CLAUDE_PLAN_TOKEN", "OIUI_AGENT_SECRET")):
    sys.exit(3)
if "oiui-claude-signin-" not in os.environ.get("HOME", "") or not os.environ.get("CLAUDE_CONFIG_DIR", "").startswith(os.environ["HOME"]):
    sys.exit(4)
print("\x1b[2J\x1b[1;1HBrowser didn't open? Use the url below to sign in:")
print(f"\x1b]8;;{url}\x07{url[:40]}\r\n{url[40:]}\x1b]8;;\x07")
sys.stdout.write("Paste\x1b[7Gcode\x1b[12Ghere\x1b[17Gif\x1b[20Gprompted\x1b[29G> ")
sys.stdout.flush()
code = sys.stdin.readline().strip()
if code == "good-code":
    print("\x1b[32m✓\x1b[0m Long-lived authentication token created successfully!")
    print("Your OAuth token (valid for 1 year):")
    print("sk-ant-oat01-FAKEFAKEFAKEFAKEFAKEFAKEFAKEFAKEFAKEFAKE_fake-token")
else:
    print("OAuth error: Invalid code")
    sys.stdin.readline()
